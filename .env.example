NODE_ENV=production
PORT=3000
BASE_URL=https://your-domain.hostingersite.com
# Point to a persistent directory outside the replaceable release directory.
DATA_DIR=/absolute/persistent/path/chairulhuda-data
# Set once to provision the initial administrator. No default credentials exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional. No inquiry is sent externally: submissions remain in the admin dashboard.
CONTACT_EMAIL=
