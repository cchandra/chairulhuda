<section class="page-intro container"><div class="eyebrow">RUANG SAYA</div><h1>Selamat datang,<br><em><%= user.name %>.</em></h1><div class="account-bar"><span class="badge"><%= isPro?'Profesional aktif':'Akun publik' %></span><% if(user.role==='admin'){ %><a class="button compact" href="/admin">Dashboard pengelola ↗</a><% } %><form method="post" action="/keluar"><button class="text-button">Keluar dari akun</button></form></div></section><section class="container section-topless"><div class="section-heading"><h2>Bacaan tersimpan.</h2><a class="text-link" href="/pustaka">Jelajahi pustaka ↗</a></div><% if(materials.length){ %><%- include('../partials/cards',{materials}) %><% }else{ %><div class="empty-state small"><h3>Ruang untuk bacaan pilihan Anda.</h3><p>Buka sebuah materi lalu pilih “Simpan bacaan”.</p><a class="button outline" href="/pustaka">Temukan bacaan ↗</a></div><% } %><div class="account-details"><div><h2>Permintaan saya.</h2><% if(!inquiries.length){ %><p>Belum ada permintaan yang dikirim melalui akun ini.</p><% } %><% inquiries.forEach(q=>{ %><div class="request-row"><strong><%= q.type %></strong><span><%= {new:'Menunggu tinjauan',reviewed:'Ditinjau',closed:'Selesai'}[q.status] %></span><p><%= q.message %></p></div><% }) %></div><div><h2>Keamanan akun.</h2><form class="form" method="post" action="/akun/password"><label>Kata sandi saat ini<input name="current" type="password" autocomplete="current-password" required></label><label>Kata sandi baru<input name="password" type="password" autocomplete="new-password" minlength="12" maxlength="256" required></label><button class="button outline">Perbarui kata sandi</button></form></div></div></section>
