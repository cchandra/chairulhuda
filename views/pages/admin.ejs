<section class="container admin-page"><div class="section-heading"><div><span class="eyebrow">DASHBOARD PENGELOLA</span><h1>Ruang editorial.</h1></div><a class="button" href="/admin/materi/baru">＋ Tambah materi</a></div><nav class="admin-tabs"><a href="#materi">Materi <span><%= materials.length %></span></a><a href="#anggota">Anggota <span><%= members.length %></span></a><a href="#permintaan">Permintaan <span><%= inquiries.filter(q=>q.status==='new').length %> baru</span></a><a href="/akun">Akun saya ↗</a></nav><section id="materi" class="admin-block"><h2>Kelola materi.</h2><div class="table-scroll"><table><thead><tr><th>Judul & penulis</th><th>Jenis</th><th>Akses</th><th>Status</th><th>Aksi</th></tr></thead><tbody><% materials.forEach(m=>{ %><tr><td><strong><%= m.title %></strong><small><%= m.author %></small></td><td><%= m.kind %></td><td><%= m.access==='premium'?'Profesional':'Publik' %></td><td><span class="badge"><%= m.status==='published'?'Terbit':'Draf' %></span></td><td><a class="text-link" href="/admin/materi/<%= m.id %>">Edit ↗</a></td></tr><% }) %></tbody></table></div></section><section id="anggota" class="admin-block"><h2>Anggota & akses.</h2><p>Aktifkan akses setelah kesepakatan dan pembayaran diverifikasi di luar website. Kosongkan tanggal untuk mencabut akses premium.</p><div class="table-scroll"><table><thead><tr><th>Anggota</th><th>Peran</th><th>Akses Profesional sampai</th></tr></thead><tbody><% members.forEach(m=>{ %><tr><td><strong><%= m.name %></strong><small><%= m.email %></small></td><td><%= m.role==='admin'?'Admin':'Anggota' %></td><td><% if(m.role!=='admin'){ %><form class="inline-form" method="post" action="/admin/anggota/<%= m.id %>"><label class="sr-only" for="until-<%= m.id %>">Tanggal akhir akses <%= m.name %></label><input id="until-<%= m.id %>" name="until" type="date" value="<%= m.membership_until?.slice(0,10)||'' %>"><button class="button compact">Simpan</button></form><% }else{ %>Akses pengelola<% } %></td></tr><% }) %></tbody></table></div></section><section id="permintaan" class="admin-block"><h2>Permintaan masuk.</h2><% if(!inquiries.length){ %><p>Belum ada permintaan.</p><% } %><% inquiries.forEach(q=>{ %><article class="admin-inquiry"><div class="section-heading"><div><span class="badge"><%= q.type %></span><h3><%= q.name %></h3><a href="mailto:<%= q.email %>"><%= q.email %></a><span class="muted"> · <%= q.organization||'Individual' %></span></div><form class="inline-form" method="post" action="/admin/permintaan/<%= q.id %>"><label class="sr-only" for="status-<%= q.id %>">Status permintaan <%= q.id %></label><select name="status" id="status-<%= q.id %>"><% Object.entries({new:'Baru',reviewed:'Ditinjau',closed:'Selesai'}).forEach(([v,l])=>{ %><option value="<%= v %>" <%= q.status===v?'selected':'' %>><%= l %></option><% }) %></select><button class="button compact">Simpan</button></form></div><p class="inquiry-message"><%= q.message %></p><small><%= q.created_at %> UTC</small></article><% }) %></section></section>
