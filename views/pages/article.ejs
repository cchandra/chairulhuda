<article class="article-page"><div class="container"><a class="back-link" href="/pustaka">← Kembali ke pustaka</a><div class="article-layout"><aside><span class="eyebrow">DALAM PUSTAKA</span><p><%= material.topic %></p><hr><p class="muted"><%= material.kind %><br><%= material.access==='premium'?'Akses Profesional':'Akses terbuka' %></p><% if(user){ %><form method="post" action="/simpan/<%= material.id %>"><button class="button outline compact"><%= saved?'✓ Tersimpan':'＋ Simpan bacaan' %></button></form><% }else{ %><a class="text-link" href="/masuk">Masuk untuk menyimpan ↗</a><% } %></aside><div class="article-main"><div class="eyebrow"><%= material.topic %></div><h1><%= material.title %></h1><p class="article-lead"><%= material.summary %></p><div class="author-line"><span class="avatar">CH</span><div><strong><%= material.author %></strong><small>Diperbarui <%= new Date(material.updated_at+'Z').toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'}) %></small></div><button class="share-button" data-copy-link>Salin tautan ↗</button></div><% if(locked){ %><div class="paywall"><span class="eyebrow">AKSES PROFESIONAL</span><h2>Lanjutkan pendalaman Anda.</h2><p>Kajian lengkap ini tersedia untuk anggota Profesional aktif.</p><a class="button" href="/profesional">Pelajari keanggotaan ↗</a><% if(!user){ %><p>Sudah menjadi anggota? <a href="/masuk">Masuk ke akun</a></p><% } %></div><% }else{ %><% if(material.attachment?.endsWith('.mp4')){ %><video class="material-media" controls preload="metadata"><source src="/media/<%= material.id %>" type="video/mp4">Browser Anda tidak mendukung pemutaran video.</video><% }else if(material.attachment?.endsWith('.mp3')){ %><audio class="material-media" controls preload="metadata"><source src="/media/<%= material.id %>" type="audio/mpeg">Browser Anda tidak mendukung pemutaran audio.</audio><% } %><div class="prose"><% material.body.split(/\n\s*\n/).forEach(p=>{ %><p><%= p %></p><% }) %></div><% if(material.source_url){ %><div class="source-box"><span class="eyebrow">REFERENSI</span><a href="<%= material.source_url %>" target="_blank" rel="noopener noreferrer"><%= material.source_label||'Buka sumber' %> ↗</a></div><% } %><% if(material.attachment){ %><a class="button outline" href="/unduh/<%= material.id %>">Unduh berkas <%= material.attachment_name?.split('.').pop().toUpperCase() %> ↓</a><% } %><% if(material.author==='Tim Editorial'){ %><p class="editorial-note">Pengantar tim editorial. Materi ini bukan tulisan atau pendapat hukum Prof. Chairul Huda.</p><% } %><% } %></div></div></div></article>
