<section class="page-intro container"><div class="eyebrow">PUSTAKA</div><h1><%= kind==='Bedah Putusan'?'Bedah putusan.':'Pustaka hukum pidana.' %></h1><p>Cari artikel, kajian, makalah, dan materi pembelajaran.</p></section><section class="container library-section"><form class="library-filters" action="/pustaka"><label class="search-field"><span class="sr-only">Kata kunci</span><input name="q" value="<%= q %>" placeholder="Cari dalam pustaka…" maxlength="150"></label><label><span class="sr-only">Topik</span><select name="topik"><option value="">Semua topik</option><% topics.forEach(t=>{ %><option <%= t===topic?'selected':'' %>><%= t %></option><% }) %></select></label><label><span class="sr-only">Jenis materi</span><select name="jenis"><option value="">Semua materi</option><% ['Artikel','Bedah Putusan','Kelas','Makalah'].forEach(t=>{ %><option <%= t===kind?'selected':'' %>><%= t %></option><% }) %></select></label><button class="button" type="submit">Cari →</button></form><div class="result-line"><span><%= materials.length %> materi<%= topic?' · '+topic:'' %></span><% if(q||topic||kind){ %><a href="/pustaka">Hapus filter ×</a><% } %></div><% if(materials.length){ %><%- include('../partials/cards',{materials}) %><% }else{ %><div class="empty-state"><span class="empty-symbol">§</span><h2><%= q?'Belum ada hasil.':'Belum ada materi.' %></h2><p><%= q?'Coba kata kunci atau topik lain.':'Materi akan ditampilkan setelah diterbitkan.' %></p><a class="button outline" href="/pustaka">Lihat semua materi</a></div><% } %></section>
