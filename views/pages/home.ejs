<section class="study-statement container">
  <div class="study-section-index"><span>01</span><span>TENTANG</span></div>
  <h2>Pusat publikasi dan pembelajaran hukum pidana.</h2>
  <p>Website ini menghimpun tulisan, makalah, kajian, bedah putusan, dan materi pembelajaran Prof. Chairul Huda untuk publik dan praktisi hukum.</p>
  <a href="/tentang">Profil lengkap <span>→</span></a>
</section>

<section class="study-publications">
  <div class="container">
    <header class="study-section-head">
      <div class="study-section-index"><span>02</span><span>PUBLIKASI TERBARU</span></div>
      <h2>Artikel dan kajian.</h2>
      <a href="/pustaka">Semua publikasi <span>→</span></a>
    </header>
    <%- include('../partials/cards',{materials}) %>
  </div>
</section>

<section class="study-topics container">
  <div class="study-topics-head">
    <div class="study-section-index"><span>03</span><span>INDEKS BIDANG</span></div>
    <h2>Hukum pidana,<br>berdasarkan topik.</h2>
    <form class="study-search" action="/pustaka">
      <label class="sr-only" for="study-search">Cari pustaka</label>
      <input id="study-search" name="q" placeholder="Cari pustaka" maxlength="150">
      <button type="submit" aria-label="Cari">→</button>
    </form>
  </div>
  <div class="study-topic-list">
    <% topics.forEach((topic,index)=>{ %>
      <a href="/pustaka?topik=<%= encodeURIComponent(topic) %>">
        <span><%= String(index+1).padStart(2,'0') %></span>
        <strong><%= topic %></strong>
        <i>↗</i>
      </a>
    <% }) %>
  </div>
</section>

<section class="study-professional">
  <div class="container">
    <div class="study-section-index"><span>04</span><span>AKSES PROFESIONAL</span></div>
    <h2>Materi untuk lawyer<br>dan firma hukum.</h2>
    <ul>
      <li>Kajian dan bedah putusan</li>
      <li>Dokumen pendamping riset</li>
      <li>Kelas dan diskusi tematik</li>
    </ul>
    <a href="/profesional">Lihat akses profesional <span>→</span></a>
  </div>
</section>
