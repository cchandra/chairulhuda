    <h1 id="study-title"><span>Prof.</span> Chairul<br>Huda.</h1>
    <p>Ahli hukum pidana dan akademisi.</p>
    <nav class="study-directory" aria-label="Akses utama">
      <a href="/pustaka"><span>01</span><strong>Tulisan dan kajian</strong><i>→</i></a>
      <a href="/pustaka?jenis=Bedah%20Putusan"><span>02</span><strong>Bedah putusan</strong><i>→</i></a>
      <a href="/kelas"><span>03</span><strong>Kelas hukum pidana</strong><i>→</i></a>
      <a href="/layanan"><span>04</span><strong>Layanan ahli</strong><i>→</i></a>
    </nav>
  </div>
  <div class="study-hero-room">
    <img src="/ruang-study-chairul-huda.jpg" alt="Ruang study Prof. Chairul Huda" width="1152" height="1536" fetchpriority="high">
    <figure class="study-professor">
      <img src="/chairul-huda-2025.jpg" alt="Prof. Chairul Huda memberikan keterangan sebagai ahli di Mahkamah Konstitusi" width="746" height="346" fetchpriority="high">
