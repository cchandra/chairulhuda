<section class="auth-section container"><div class="auth-side"><span class="eyebrow">RUANG PENGETAHUAN ANDA</span><h1>Bacaan tersimpan.<br><em>Pemahaman bertumbuh.</em></h1><p>Simpan materi pilihan dan ikuti perkembangan permintaan Anda dalam satu akun.</p><span class="auth-sign">CH.</span></div><div class="auth-card"><span class="eyebrow"><%= mode==='login'?'SELAMAT DATANG KEMBALI':'MULAI DARI RASA INGIN TAHU' %></span><h2><%= mode==='login'?'Masuk ke akun.':'Buat akun gratis.' %></h2><% if(error){ %><div class="alert" role="alert"><%= error %></div><% } %><form class="form" method="post" action="<%= mode==='login'?'/masuk':'/daftar' %>"><% if(mode==='register'){ %><label>Nama lengkap<input name="name" autocomplete="name" required maxlength="100" value="<%= values.name||'' %>"></label><% } %><label>Email<input type="email" name="email" autocomplete="email" required maxlength="254" value="<%= values.email||'' %>"></label><label>Kata sandi<input type="password" name="password" autocomplete="<%= mode==='login'?'current-password':'new-password' %>" required minlength="<%= mode==='register'?12:1 %>" maxlength="256"><% if(mode==='register'){ %><small>Minimal 12 karakter.</small><% } %></label><% if(mode==='register'){ %><label class="check"><input type="checkbox" name="consent" value="yes" required><span>Saya menyetujui <a href="/privasi">privasi dan ketentuan penggunaan</a>.</span></label><% } %><button class="button"><%= mode==='login'?'Masuk':'Buat akun' %> <span>↗</span></button></form><p class="auth-switch"><%= mode==='login'?'Belum memiliki akun?':'Sudah memiliki akun?' %> <a href="<%= mode==='login'?'/daftar':'/masuk' %>"><%= mode==='login'?'Daftar gratis':'Masuk' %></a></p><% if(mode==='login'){ %><p class="form-note">Perlu bantuan akses akun? <a href="/layanan">Hubungi pengelola melalui formulir layanan.</a></p><% } %></div></section>
