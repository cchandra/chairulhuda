<div class="article-grid"><% materials.forEach((m,i)=>{ %><article class="article-card"><a href="/pustaka/<%= m.slug %>" class="card-cover cover-<%= i%3 %>" aria-label="Baca <%= m.title %>"><span class="cover-index">0<%= i+1 %> / PUSTAKA</span><span class="cover-word"><%= m.topic==='Putusan & Pembuktian'?'Ratio.':m.topic==='Pertanggungjawaban Pidana'?'Culpa.':'Lex.' %></span><span class="cover-bottom"><%= m.topic %><span>↗</span></span></a><div class="card-meta"><span><%= m.kind %></span><span class="badge <%= m.access==='premium'?'premium':'' %>"><%= m.access==='premium'?'Profesional':'Akses terbuka' %></span></div><h3><a href="/pustaka/<%= m.slug %>"><%= m.title %></a></h3><p><%= m.summary %></p><div class="card-byline"><span><%= m.author %></span><a href="/pustaka/<%= m.slug %>" aria-label="Baca <%= m.title %>">Baca <span>↗</span></a></div></article><% }) %></div>
