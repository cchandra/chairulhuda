<div class="reading-list"><% materials.forEach((m,i)=>{ %><article class="reading-entry"><div class="reading-meta"><span class="reading-number"><%= String(i+1).padStart(2,'0') %></span><span><%= m.kind %></span><span class="reading-access <%= m.access==='premium'?'premium':'' %>"><%= m.access==='premium'?'Profesional':'Akses terbuka' %></span></div><div class="reading-body"><a class="reading-topic" href="/pustaka?topik=<%= encodeURIComponent(m.topic) %>"><%= m.topic %></a><h3><a href="/pustaka/<%= m.slug %>"><%= m.title %></a></h3><p><%= m.summary %></p><span class="reading-author"><%= m.author %></span></div><a class="reading-open" href="/pustaka/<%= m.slug %>" aria-label="Baca <%= m.title %>"><span aria-hidden="true">↗</span></a></article><% }) %></div>